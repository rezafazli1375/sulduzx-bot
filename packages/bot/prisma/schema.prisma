generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bot {
  id        Int      @id @default(autoincrement())
  name      String
  token     String   @unique
  username  String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  /// کلیدهای قابلیت‌هایی که این ربات مجاز به استفاده از آن‌ها نیست (خالی = همه)
  blockedFeatures String[] @default([]) @map("blocked_features")
  /// کلید بازی‌هایی که این ربات نشان نمی‌دهد (خالی = همهٔ بازی‌های فعال)
  blockedGames    String[] @default([]) @map("blocked_games")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  channels  Channel[]
  groups    GroupChat[]
  /// زمان‌بندی‌های پخش خودکار موزیک این ربات (با حذف ربات، زمان‌بندی‌هایش هم می‌روند)
  musicSchedules MusicSchedule[]

  @@map("bots")
}

model User {
  id                Int       @id @default(autoincrement())
  botId             Int       @map("bot_id")
  telegramId        BigInt    @map("telegram_id")
  username          String?
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  phone             String?
  referralCode      String    @unique @map("referral_code")
  referredBy        Int?      @map("referred_by")
  points            Int       @default(0)
  isBlocked         Boolean   @default(false) @map("is_blocked")
  isAdmin           Boolean   @default(false) @map("is_admin")
  configBlocked     Boolean   @default(false) @map("config_blocked")
  configQuotaOverride Int?    @map("config_quota_override")
  blockedFeatures   String[]  @default([]) @map("blocked_features")
  freeAccountUsed   Boolean   @default(false) @map("free_account_used")
  freeAccountAt     DateTime? @map("free_account_at")
  panelUserId       Int?      @map("panel_user_id")
  panelUserName     String?   @map("panel_user_name")
  /// شناسهٔ آخرین پاداشی که «می‌توانی بخری» برایش فرستاده شد (ضد اسپم)
  rewardNoticeKey   String?   @map("reward_notice_key")
  /// زمان ارسال آن اطلاع‌رسانی — برای تکرار نشدن
  rewardNoticeAt    DateTime? @map("reward_notice_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  bot               Bot       @relation(fields: [botId], references: [id])
  referredUsers     User[]    @relation("UserReferrals")
  referrer          User?     @relation("UserReferrals", fields: [referredBy], references: [id])
  tickets           Ticket[]
  channelStatuses   UserChannelStatus[]
  downloads         Download[]
  pointTransactions PointTransaction[]
  configClaims      ConfigClaim[]
  redemptions       RewardRedemption[]

  @@unique([botId, telegramId])
  @@map("users")
}

model ConfigClaim {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("config_claims")
}

model Channel {
  id              Int       @id @default(autoincrement())
  botId           Int       @map("bot_id")
  channelId       BigInt    @map("channel_id")
  channelUsername String    @map("channel_username")
  title           String?
  isRequired      Boolean   @default(true) @map("is_required")
  joinOrder       Int       @default(0) @map("join_order")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  bot             Bot       @relation(fields: [botId], references: [id])
  userStatuses    UserChannelStatus[]

  @@unique([botId, channelId])
  @@unique([botId, channelUsername])
  @@map("channels")
}

model UserChannelStatus {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  channelId Int      @map("channel_id")
  joined    Boolean  @default(false)
  joinedAt  DateTime? @map("joined_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@map("user_channel_statuses")
}

model Ticket {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  subject     String
  message     String    @db.Text
  status      TicketStatus @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  adminReply  String?   @db.Text @map("admin_reply")
  repliedBy   Int?      @map("replied_by")
  repliedAt   DateTime? @map("replied_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model Download {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  type        DownloadType
  url         String    @db.Text
  filePath    String?   @map("file_path")
  fileSize    Int?      @map("file_size")
  status      DownloadStatus @default(PENDING)
  error       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("downloads")
}

model PointTransaction {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  amount      Int
  type        PointType
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_transactions")
}

/// سطح پاداش: چند امتیاز ← چند گیگ / چند روز. در پنل «پاداش‌ها» تعریف می‌شود.
model PointReward {
  id         Int      @id @default(autoincrement())
  title      String
  /// توضیح کوتاه زیر نام پاداش در ربات
  subtitle   String?  @db.Text
  costPoints Int      @map("cost_points")
  dataGb     Float    @map("data_gb")
  days       Int
  limitIp    Int      @default(2) @map("limit_ip")
  /// اینباند مقصد در پنل x-ui؛ خالی = PANEL_INBOUND_ID / settings.panel_inbound_id
  inboundId  Int?     @map("inbound_id")
  /// سقف دریافت برای هر کاربر؛ خالی = نامحدود
  maxPerUser Int?     @map("max_per_user")
  /// موجودی؛ خالی = نامحدود
  stock      Int?
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  redemptions RewardRedemption[]

  @@map("point_rewards")
}

/// دفتر خروج امتیاز و کانفیگ صادرشده. email منحصربه‌فرد است تا خرج دوبارهٔ یک موجودی ممکن نباشد.
model RewardRedemption {
  id         Int              @id @default(autoincrement())
  userId     Int              @map("user_id")
  rewardId   Int?             @map("reward_id")
  email      String           @unique
  costPoints Int              @map("cost_points")
  dataGb     Float            @map("data_gb")
  days       Int
  inboundId  Int?             @map("inbound_id")
  status     RedemptionStatus @default(PENDING)
  failReason String?          @map("fail_reason") @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward PointReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([rewardId, status])
  @@map("reward_redemptions")
}

model Setting {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  value       String    @db.Text
  type        SettingType @default(STRING)
  description String?
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("settings")
}

model MenuButton {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  color     String   @default("none")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("menu_buttons")
}

model BotText {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  title     String
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bot_texts")
}

model ShopItem {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shop_items")
}

model MtprotoProxy {
  id          Int       @id @default(autoincrement())
  server      String
  port        Int
  secret      String
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("mtproto_proxies")
}

model AdminUser {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  password    String
  email       String?   @unique
  role        AdminRole @default(ADMIN)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  adminId     Int?      @map("admin_id")
  action      String
  entity      String
  entityId    String?   @map("entity_id")
  oldValues   Json?     @map("old_values")
  newValues   Json?     @map("new_values")
  ipAddress   String?   @map("ip_address")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("audit_logs")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DownloadType {
  INSTAGRAM
  YOUTUBE
}

enum DownloadStatus {
  PENDING
  DOWNLOADING
  COMPLETED
  FAILED
}

enum PointType {
  REFERRAL
  DAILY_CHECKIN
  CHANNEL_JOIN
  BONUS
  REDEMPTION
}

enum RedemptionStatus {
  PENDING
  ISSUED
  FAILED
  REFUNDED
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

// ──────────────────────────────────────────────
// Games
// ──────────────────────────────────────────────

model GameQuestion {
  id        Int           @id @default(autoincrement())
  gameType  GameType      @map("game_type")
  text      String        @db.Text
  optionA   String?       @map("option_a")
  optionB   String?       @map("option_b")
  optionC   String?       @map("option_c")
  optionD   String?       @map("option_d")
  answer    String        @default("A")
  isActive  Boolean       @default(true) @map("is_active")
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("game_questions")
}

model GameSession {
  id          Int          @id @default(autoincrement())
  chatId      BigInt       @map("chat_id")
  messageId   BigInt?      @map("message_id")
  botId       Int          @map("bot_id")
  gameType    GameType     @map("game_type")
  status      GameStatus   @default(WAITING)
  players     Json         @default("[]")
  currentTurn Int          @default(0) @map("current_turn")
  board       Json?
  bombs       Json?
  revealed    Json?
  round       Int          @default(1)
  winnerId    BigInt?      @map("winner_id")
  data        Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("game_sessions")
}

enum GameType {
  TRUTH_OR_DARE
  TIC_TAC_TOE
  MINESWEEPER
  WORDLE
  HOKM
  MENCH
  SCALA
}

enum GameStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

// ──────────────────────────────────────────────
// Groups (chat membership of the bot) & Music
// ──────────────────────────────────────────────

/// گروه‌هایی که ربات در آن‌ها عضو است — از رویدادهای تلگرام پر می‌شود
model GroupChat {
  id          Int       @id @default(autoincrement())
  botId       Int       @map("bot_id")
  chatId      BigInt    @map("chat_id")
  title       String?
  username    String?
  chatType    String    @default("supergroup") @map("chat_type")
  memberCount Int?      @map("member_count")
  botIsAdmin  Boolean   @default(false) @map("bot_is_admin")
  isJoined    Boolean   @default(true) @map("is_joined")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  leftAt      DateTime? @map("left_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  bot         Bot         @relation(fields: [botId], references: [id])
  musicPlays  MusicPlay[]

  @@unique([botId, chatId])
  @@index([botId, isJoined])
  @@map("group_chats")
}

/// کتابخانهٔ آهنگ‌ها. این کتابخانه **مشترک** است: به هیچ رباتی وابسته نیست و
/// هر رباتی که در پنل فعال باشد از همان آهنگ‌ها پخش می‌کند. منبع هر آهنگ یک
/// فایل محلی روی volume است (filePath)؛ ربات همان فایل را موقع پخش به قالب
/// ویس (OGG/Opus) تبدیل می‌کند و با کپشن «نام آهنگ + آیدی ربات» می‌فرستد.
model MusicTrack {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String?
  filePath  String   @map("file_path")
  duration  Int?
  fileSize  Int?     @map("file_size")
  mimeType  String?  @map("mime_type")
  playCount Int      @default(0) @map("play_count")
  isActive  Boolean  @default(true) @map("is_active")
  addedBy   BigInt?  @map("added_by")
  source    String   @default("panel")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plays MusicPlay[]

  @@index([isActive])
  @@map("music_tracks")
}

model MusicPlay {
  id        Int             @id @default(autoincrement())
  trackId   Int             @map("track_id")
  botId     Int             @map("bot_id")
  chatId    BigInt          @map("chat_id")
  requestId BigInt?         @map("request_id")
  requestName String?       @map("request_name")
  messageId BigInt?         @map("message_id")
  status    MusicPlayStatus @default(PLAYING)
  startedAt DateTime        @default(now()) @map("started_at")
  endedAt   DateTime?       @map("ended_at")

  track MusicTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  group GroupChat?  @relation(fields: [botId, chatId], references: [botId, chatId])

  @@index([status, startedAt])
  @@index([chatId])
  @@map("music_plays")
}

enum MusicPlayStatus {
  PLAYING
  PAUSED
  FINISHED
  STOPPED
  FAILED
}

/// پخش خودکار موزیک در زمان تعیین‌شده.
/// هر سطر یک «ربات + ساعت/روز + گروه‌های انتخابی» است. در زمانش، یک آهنگ
/// تصادفی از کتابخانهٔ مشترک به‌شکل ویس (با همان کپشن همیشگی: خط اول نام آهنگ،
/// خط دوم آیدی ربات) در همهٔ گروه‌های آن سطر فرستاده می‌شود.
/// kind:
///   daily    → times («HH:MM») در روزهای days (خالی = هر روز)
///   interval → هر intervalMinutes دقیقه
///   once     → یک بار در onceAt، بعد خودش غیرفعال می‌شود
/// chatIds رشته‌اند چون شناسهٔ گروه تلگرام از حد امن اعداد جاوااسکریپت bigger است.
/// nextRunAt همیشه در UTC ذخیره می‌شود و از روی timezone محاسبه می‌گردد.
model MusicSchedule {
  id              Int       @id @default(autoincrement())
  name            String?
  botId           Int       @map("bot_id")
  chatIds         String[]  @default([]) @map("chat_ids")
  kind            String    @default("daily")
  times           String[]  @default([])
  days            Int[]     @default([])
  intervalMinutes Int?      @map("interval_minutes")
  onceAt          DateTime? @map("once_at")
  timezone        String    @default("Asia/Tehran")
  isActive        Boolean   @default(true) @map("is_active")
  lastRunAt       DateTime? @map("last_run_at")
  nextRunAt       DateTime? @map("next_run_at")
  /// خلاصهٔ فارسی آخرین اجرا (چند گروه ارسال شد / چرا نشد) تا در پنل دیده شود
  lastResult      String?   @map("last_result")
  runCount        Int       @default(0) @map("run_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([isActive, nextRunAt])
  @@index([botId])
  @@map("music_schedules")
}
