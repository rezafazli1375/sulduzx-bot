# ================== Telegram ==================
# توکن ربات را از @BotFather بگیرید
BOT_TOKEN=123456789:AAExampleTokenReplaceWithYourOwn
BOT_USERNAME=your_bot_username
# آیدی عددی ادمین‌ها (با کاما جدا کنید)
ADMIN_IDS=123456789

# ================== Database ==================
POSTGRES_USER=sulduz
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=sulduz_bot
DATABASE_URL=postgresql://sulduz:change-me-to-a-strong-password@postgres:5432/sulduz_bot?schema=public

# ================== x-ui Panel ==================
# آدرس و اطلاعات ورود پنل 3x-ui (برای ساخت کانفیگ)
PANEL_BASE_URL=https://panel.example.com:8443
PANEL_USERNAME=admin
PANEL_PASSWORD=
PANEL_INBOUND_ID=

# ================== Security ==================
# یک رشته تصادفی طولانی بسازید: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret
# نام کاربری/رمز اولیه پنل مدیریت (فقط هنگام seed استفاده می‌شود)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-default-password

# ================== App ==================
PORT=3000
NODE_ENV=production
TZ=Asia/Tehran
# آدرس عمومی پنل مدیریت (در پیام‌های ربات نمایش داده می‌شود)
ADMIN_PANEL_URL=https://bot.example.com
# پروکسی پیش‌فرض yt-dlp (اختیاری)
YTDLP_PROXY=
